{
  "exclude": ["node_modules"],
  "include": [
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "target": "ES2017",
    "module": "ESNext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.iterable", "ESNext"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "envin/env": ["./env.config.ts"],
      "#/*": ["./lib/*"],
      "@/*": ["./src/*"]
    }
  }
}
