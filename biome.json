{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": true
              },
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"],
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!.next", "!.void", "!**/*.svg"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 96,
    "indentWidth": 2,
    "lineEnding": "lf",
    "indentStyle": "space",
    "formatWithErrors": false,
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "lineWidth": 96,
      "quoteStyle": "single",
      "semicolons": "always",
      "bracketSpacing": true,
      "trailingCommas": "all",
      "bracketSameLine": false,
      "jsxQuoteStyle": "double",
      "attributePosition": "auto",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "expand": "auto",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      },
      "complexity": {
        "noArguments": "error",
        "noBannedTypes": "off",
        "noUselessFragments": "off",
        "noUselessTypeConstraint": "error"
      },
      "correctness": {
        "noConstAssign": "off",
        "noUnreachable": "off",
        "noChildrenProp": "off",
        "noSetterReturn": "off",
        "noPrecisionLoss": "error",
        "noUnusedVariables": "off",
        "noUnreachableSuper": "off",
        "noGlobalObjectCalls": "off",
        "useUniqueElementIds": "off",
        "noUndeclaredVariables": "off",
        "useJsxKeyInIterable": "error",
        "useExhaustiveDependencies": "off",
        "noInvalidConstructorSuper": "off",
        "noInvalidBuiltinInstantiation": "off",
        "noInvalidUseBeforeDeclaration": "off",
        "noUnusedImports": {
          "level": "warn",
          "fix": "safe"
        }
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "warn"
        }
      },
      "security": {
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "useConst": "error",
        "noNamespace": "off",
        "noParameterAssign": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "useAsConstAssertion": "error"
      },
      "suspicious": {
        "noVar": "error",
        "noRedeclare": "off",
        "noExplicitAny": "off",
        "noImportAssign": "off",
        "useGetterReturn": "off",
        "noCommentText": "error",
        "noArrayIndexKey": "off",
        "noUnsafeNegation": "off",
        "noFunctionAssign": "off",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "off",
        "noDuplicateParameters": "off",
        "noDuplicateClassMembers": "off",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error"
      }
    }
  }
}
