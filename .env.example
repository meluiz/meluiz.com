# Public URL of the app, used for metadata and absolute links
APP_URL=http://localhost:3000

# Bearer token for the self-hosted visitors API (https://visitors.meluiz.com)
VISITORS_TOKEN=

# Cloudflare Web Analytics site token (Cloudflare dashboard > Web Analytics > site > JS snippet)
CLOUDFLARE_TOKEN=

# Optional: ISO datetime of the build, set automatically by next.config.ts
# BUILD_TIMESTAMP=

# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA and NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA are provided by Vercel at build/runtime
